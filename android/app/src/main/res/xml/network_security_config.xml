<?xml version="1.0" encoding="utf-8"?>
<!--
    Network Security Config (Android 7.0+) — release(main) 기준.

    base-config: 전역 기본 — cleartext 차단 + system CA 만 신뢰.
    debug-overrides: debuggable 빌드에서만 user CA 추가 신뢰(프록시 디버깅).

    ⚠️ 로컬 dev 서버용 cleartext 허용(10.0.2.2·localhost·LAN IP)은 여기 두지 않는다.
    domain-config 는 debuggable 여부와 무관하게 release 에도 적용되므로, main 에 두면
    release APK 가 해당 호스트로 평문 HTTP 를 보낼 수 있다. 그 허용 목록은
    src/debug/res/xml/network_security_config_debug.xml 에 있고, src/debug/AndroidManifest.xml 이
    debug 빌드에서만 그 파일로 교체한다.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
