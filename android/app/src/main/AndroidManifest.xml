<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        tools:replace="android:usesCleartextTraffic" 가 필요한 이유:
        :capacitor-cordova-android-plugins 모듈의 manifest 가
        application@usesCleartextTraffic="true" 를 선언해 manifest merger 가
        충돌한다. app 모듈이 false 를 강제하고 networkSecurityConfig 로
        세부 도메인 허용을 제어한다.

        백업: allowBackup=false 는 Android 12+ 의 기기 간 이전(D2D)을 막지 못하므로
        dataExtractionRules(12+)·fullBackupContent(11 이하)로 클라우드 백업과 기기 간 이전 모두에서
        앱 데이터 전체(WebView 쿠키·저장소 포함)를 제외한다 — 세션 쿠키가 다른 기기로 복제되지 않게 한다.
    -->
    <application
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:replace="android:usesCleartextTraffic">

        <!-- AdMob APPLICATION_ID meta-data 와 GMA SDK 최적화 플래그는 두지 않는다 — 첫 출시는 광고 제외라
             capacitor.config.ts 의 android.includePlugins 가 @capacitor-community/admob 을 뺀다.
             광고 도입 시 플러그인과 함께 복원 (docs/admob-config.md). -->

        <!-- FCM notification payload 가 icon/color 를 생략해도 런처 아이콘 전체가 흰 사각형으로
             렌더되지 않도록, 알림 전용 단색 실루엣과 브랜드 accent 를 기본값으로 사용한다. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_color" />

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:screenOrientation="portrait"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep linking: terraworld.web-qplay.kr/share/* 만 앱이 캡처.
                 pathPrefix 없이는 해당 호스트 전 경로(약관 페이지 등)가 앱으로 열려
                 웹 레이어 DEEP_LINK_RE 가 드롭 — 목적지 유실 (2026-07-20 audit B5-3). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <!-- trailing slash — "/share" prefix 는 "/shareholder" 등 무관 경로까지 매칭한다 (Codex R1) -->
                <data android:scheme="https" android:host="terraworld.web-qplay.kr" android:pathPrefix="/share/" />
            </intent-filter>

            <!-- 커스텀 스킴 terraworld:// — iOS(Info.plist CFBundleURLTypes) 파리티 (audit B5-3). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="terraworld" />
            </intent-filter>

        </activity>

        <!-- 거리 기록 백그라운드 위치 수집 — while-in-use FGS (DistanceTrackerPlugin.start 가 기동) -->
        <service
            android:name=".DistanceTrackingService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <receiver
            android:name=".TerraWidgetProvider"
            android:label="@string/terra_widget_name"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/terra_widget_info" />
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <!-- Android 11+ 패키지 가시성 — 인스타그램 스토리 intent resolve 용 (InstagramStoriesPlugin).
         queries 는 <manifest> 직계여야 한다 (<application> 안이면 무효). -->
    <queries>
        <package android:name="com.instagram.android" />
    </queries>

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- CAMERA 권한은 선언하지 않는다 — frontend 가 카메라·사진 선택을 호출하지 않아(iOS 도 동일하게
         camera 플러그인 제외) 쓰지 않는 권한이 Play 권한 심사·Data safety 부담만 만든다.
         @capacitor/camera 패키지는 frontend 와의 Capacitor 의존성 파리티 때문에 남겨 두며, 플러그인
         자체 매니페스트는 CAMERA 를 선언하지 않는다. 사진 첨부 도입 시 권한과
         <uses-feature android:name="android.hardware.camera" android:required="false" /> 를 함께 복원. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- record/index.vue 거리 기록 기능(navigator.geolocation.watchPosition) — 선언 없으면
         WebView Geolocation API 가 native 권한 프롬프트를 못 띄우고 조용히 실패한다. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- 거리 기록 백그라운드 유지 (DistanceTrackingService — while-in-use FGS location).
         ACCESS_BACKGROUND_LOCATION 은 의도적으로 미사용 (화면 표시 중 시작하는 FGS 는 불요 —
         Play 정책 부담 회피). Play Console FGS location 선언서 제출 필요. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
</manifest>
