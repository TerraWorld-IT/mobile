<?xml version="1.0" encoding="utf-8"?>
<!--
    Network Security Config — debug 빌드 전용 (src/debug/AndroidManifest.xml 이 이 파일로 교체).

    main(network_security_config.xml)과 같은 신뢰 설정(system + debug 의 user CA)에 더해,
    로컬 dev 서버 접속용 cleartext 를 허용한다.
      - 10.0.2.2 (Android emulator host alias)
      - 10.0.3.2 (Genymotion alias)
      - localhost / 127.0.0.1 — 일부 디바이스 디버그용
      - 192.168.79.119 — LAN dev host, 실기기(같은 WiFi) 디버그 테스트용
    release 빌드에는 포함되지 않는다.
-->
<network-security-config>
    <!-- 이 파일은 debug 빌드에만 쓰이므로 user CA(프록시 디버깅)를 base-config 에 직접 둔다.
         <debug-overrides> 는 프로젝트 전체에 1개만 허용돼(lint NetworkSecurityConfig) main 에만 둔다. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">10.0.3.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">192.168.79.119</domain>
    </domain-config>
</network-security-config>
