<?xml version="1.0" encoding="utf-8"?>
<!--
    debug 빌드 전용 매니페스트 오버레이.
    로컬 dev 서버(10.0.2.2·localhost·LAN IP) 평문 접속 허용 목록을 debug 에만 적용한다.
    main 의 network_security_config.xml 에 domain-config 를 두면 release 에도 적용되므로 분리했다.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:networkSecurityConfig="@xml/network_security_config_debug"
        tools:replace="android:networkSecurityConfig" />
</manifest>
