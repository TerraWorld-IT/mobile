	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>

	<!-- 권한 사용 사유 — App Store 심사 시 누락되면 binary reject. 한국어
	     CFBundleDevelopmentRegion=ko 기준이라 InfoPlist.strings 별도 미사용.
	     카메라·사진 보관함 읽기 권한은 iOS 빌드에서 @capacitor/camera 를 제외했으므로 두지 않는다
	     (사진 첨부 기능 도입 시 플러그인·NSCameraUsageDescription·NSPhotoLibraryUsageDescription 복원). -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>거리 기록 중 이동 거리를 계산하기 위해 위치 정보에 접근합니다. 위치 좌표는 기기에서만 계산에 사용되고 서버로 전송·저장되지 않으며, 계산된 총 이동 거리만 기록에 저장됩니다. 거부 시 거리 기록 기능을 사용할 수 없습니다.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>꾸민 테라리움 화면을 사진 보관함에 저장하기 위해 권한이 필요합니다. 거부해도 앱의 다른 기능에는 영향이 없습니다.</string>
	<!-- iOS 14+ 로컬 네트워크 접근 안내 — dev 빌드가 같은 WiFi 의 개발 서버(사설 IP)에
	     접속할 때 표시. 프로덕션(공개 도메인)에서는 트리거되지 않음. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>같은 네트워크의 개발용 테스트 서버에 접속하기 위해 로컬 네트워크 접근을 사용합니다.</string>

	<!-- 보안: 전역 cleartext 차단 + dev 호스트만 예외 허용.
	     NSAllowsLocalNetworking: 사설망(192.168.x/10.x/.local) 로의 cleartext 허용 —
	     LAN 실기기 dev 테스트용. 프로덕션(https://terraworld.web-qplay.kr 공개 TLS)은 영향 없음. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<key>NSExceptionDomains</key>
		<dict>
			<key>localhost</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
		</dict>
	</dict>

	<!-- 인스타 스토리 직접 공유 — canOpenURL(instagram-stories://) 조회 허용
	     (InstagramStoriesPlugin.swift). 미선언 시 canOpenURL 이 항상 false. -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>instagram-stories</string>
	</array>
	<!-- 딥링크: terraworld.web-qplay.kr/share/* — Universal Links. associated-domains
	     entitlement 도 동시 활성화 필요 (App.entitlements 참조). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>app.terraworld.mobile</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>terraworld</string>
			</array>
		</dict>
	</array>

